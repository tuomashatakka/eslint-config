{
  "name": "@tuomashatakka/eslint-config",
  "version": "4.2.0",
  "description": "Default eslint configuration",
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "lint": "eslint plugins --config index.mjs",
    "test": "node test/test-runner.mjs && npm run typecheck",
    "test:format": "node test/format-cases.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tuomashatakka/eslint-config.git"
  },
  "author": "tuomashatakka",
  "license": "ISC",
  "types": "./index.d.mts",
  "bugs": {
    "url": "https://github.com/tuomashatakka/eslint-config/issues"
  },
  "homepage": "https://github.com/tuomashatakka/eslint-config#readme",
  "peerDependencies": {
    "eslint": ">=10.4.0",
    "react": "*",
    "typescript": "*"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/css": "^2.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/react": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "eslint": ">=10.4.0",
    "eslint-cssicorn": "^0.3.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint__js": "^9.14.0",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./rules": {
      "types": "./rules.d.mts",
      "default": "./rules.mjs"
    },
    "./plugins/*": {
      "types": "./plugins/*/index.d.mts",
      "default": "./plugins/*/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "config.mjs",
    "typescript-compat.mjs",
    "rules.mjs",
    "rules.d.mts",
    "plugins",
    "README.md"
  ],
  "engines": {
    "node": "^22.15.0 || >=23.5.0"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
